alias enum4linux-ng="$HOME/tools/enum4linux-ng/enum4linux-ng.py"

#------ Custom Utilities ------

ipinfo(){
    if [ -z "$1" ]
    then
        curl https://ipinfo.io/what-is-my-ip
    else curl https://ipinfo.io/$1
    fi

}

show-ips(){
    ip a | awk '/^[0-9]+: / { iface=$2} /inet / && iface { print iface, $2 }'
}